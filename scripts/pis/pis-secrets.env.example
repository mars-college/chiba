# Secrets for ./scripts/pis/* (example).
#
# Create a local copy (gitignored) and edit it, then either:
# - `source scripts/pis/.env.pis.local` before running scripts, or
# - rely on scripts auto-loading it if present.
#
# This repo's `.gitignore` ignores `.env.*.local`, so this is a good local path:
#   scripts/pis/.env.pis.local
#
# Naming:
# - For per-pi secrets, the suffix is derived from the pi-name by replacing
#   non-alphanumerics with underscores and uppercasing.
#   Example: `upper-east-2` -> `UPPER_EAST_2`

# SSH password used by bootstrap/apply-cable-launch/fast-cable-update (sshpass).
# (These scripts also honor `PI_PASSWORD` for compatibility.)
CHIBA_PI_PASSWORD=""

# Optional per-pi override:
# CHIBA_PI_PASSWORD_UPPER_EAST_2=""

# Controller / node API auth
# Optional shared key (if all Pis use the same API_KEY):
# CHIBA_API_KEY="..."
#
# CHIBA_API_KEY_UPPER_EAST_2="..."

# Eden auth (used by scripts/setup-node.sh)
# CHIBA_EDEN_KEY="..."

# WiFi provisioning (used by scripts/setup-node.sh)
# CHIBA_WIFI_SSID="BRAHMAN-AI"
# CHIBA_WIFI_PASSWORD="..."

# NAS mounting (bootstrap.sh)
# CHIBA_NAS_USER="..."
# CHIBA_NAS_PASSWORD="..."
