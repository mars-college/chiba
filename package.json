{
  "name": "chiba",
  "version": "0.1.0",
  "description": "Digital signage system for Raspberry Pi kiosks with central controller",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:controller": "pnpm --filter @chiba/controller dev",
    "dev:node": "pnpm --filter @chiba/node dev",
    "dev:player": "pnpm --filter @chiba/player dev",
    "dev:dashboard": "pnpm --filter @chiba/dashboard dev",
    "dev:full": "concurrently -k -n ctrl,node,dash,play -c blue,green,magenta,cyan \"pnpm dev:controller\" \"sleep 2 && CONTROLLER_URL=http://localhost:24422 NODE_NAME=local-test PORT=24424 pnpm dev:node\" \"pnpm dev:dashboard\" \"pnpm dev:player\"",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:api": "pnpm --filter @chiba/controller exec tsx ../../scripts/test-api.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/mars-college/chiba.git"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
