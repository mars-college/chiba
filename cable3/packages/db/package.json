{
  "name": "@chiba-cable3/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts",
    "migrate": "drizzle-kit push --force",
    "import-registry": "tsx src/cli.ts import-registry",
    "import-resources": "tsx src/cli.ts import-resources",
    "import-cable2-channels": "tsx src/cli.ts import-cable2-channels",
    "snapshot-resources": "tsx src/cli.ts snapshot-resources",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push"
  },
  "dependencies": {
    "@chiba-cable3/contracts": "workspace:*",
    "@iarna/toml": "^2.2.5",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "@types/pg": "^8.15.4"
  }
}
